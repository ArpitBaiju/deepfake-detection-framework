# Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Model Weights Directory (relative to backend/ or absolute path)
WEIGHTS_DIR=weights

# Specific model weights paths (defaults inside WEIGHTS_DIR)
BASIC_CNN_WEIGHTS=weights/basic_cnn.pth
RESNET18_WEIGHTS=weights/resnet18.pth
EFFICIENTNET_B0_WEIGHTS=weights/efficientnet_b0.pth
XCEPTION_WEIGHTS=weights/xception_current.pth

# Set to True strictly for developer testing when no weights are available yet.
# When MOCK_MODE is enabled, predictions are explicitly flagged as simulated.
MOCK_MODE=False
